# ================================
# TEMPLATE CONFIGURATION MONITORING PRODUCTION
# ================================
# ATTENTION: Ce fichier est un TEMPLATE !
# - Les valeurs réelles sont injectées via GitHub Secrets
# - Ne jamais commiter de vraies valeurs dans ce fichier
# - Utilisez validate_secrets.sh pour vérifier la configuration

# ================================
# SECRETS OBLIGATOIRES
# ================================
# Ces secrets DOIVENT être configurés dans GitHub Secrets

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD={{GRAFANA_ADMIN_PASSWORD}}
GRAFANA_SECRET_KEY={{GRAFANA_SECRET_KEY}}
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD={{GRAFANA_DB_PASSWORD}}

# Email Configuration pour les alertes
SMTP_PASSWORD={{SMTP_PASSWORD}}

# Webhook pour les alertes
WEBHOOK_TOKEN={{WEBHOOK_TOKEN}}

# ================================
# SECRETS OPTIONNELS
# ================================
# Ces secrets peuvent être configurés selon vos besoins

# Email Configuration
SMTP_HOST={{SMTP_HOST:-smtp.gmail.com}}
SMTP_PORT=587
SMTP_FROM={{SMTP_FROM:-monitoring@yourdomain.com}}
SMTP_USERNAME={{SMTP_USERNAME:-$SMTP_FROM}}
ADMIN_EMAIL={{ADMIN_EMAIL:-admin@yourdomain.com}}

# Slack Configuration (optionnel)
SLACK_WEBHOOK_URL={{SLACK_WEBHOOK_URL}}

# SSL/TLS Configuration
LETSENCRYPT_EMAIL={{LETSENCRYPT_EMAIL:-$ADMIN_EMAIL}}

# Domaine Configuration
DOMAIN={{DOMAIN:-yourdomain.com}}
MONITORING_DOMAIN={{MONITORING_DOMAIN:-monitoring.yourdomain.com}}

# API Configuration
API_HOST={{API_HOST:-api.yourdomain.com}}
API_PORT=8080

# ================================
# INSTRUCTIONS
# ================================
# 1. Configurez les secrets dans GitHub:
#    - Allez dans Settings > Secrets and variables > Actions
#    - Ajoutez chaque secret marqué comme obligatoire
#
# 2. Validez votre configuration:
#    ./validate_secrets.sh --github-actions
#
# 3. Déployez avec GitHub Actions:
#    - Push sur main/production déclenche le déploiement
#    - Ou utilisez workflow_dispatch pour un déploiement manuel
#
# 4. Pour un déploiement local de test:
#    ./validate_secrets.sh --generate-missing
#    source .env.generated
#    ./deploy_monitoring_prod.sh deploy
