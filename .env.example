# Configuration de la base de données
DATABASE_URL=postgresql://username:password@host:port/database
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=onlyflick
DB_SSLMODE=disable

# Configuration JWT
JWT_SECRET=your-secret-key
JWT_EXPIRATION=24

# Configuration CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:49219,http://127.0.0.1:3000,http://127.0.0.1:49219
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ===========================================
# CONFIGURATION STRIPE
# ===========================================

# Clés API Stripe (récupérées depuis le Dashboard Stripe)
# Pour les tests : utilisez les clés commençant par sk_test_ et pk_test_
# Pour la production : utilisez les clés commençant par sk_live_ et pk_live_
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Secret du webhook Stripe
# Pour le développement local : utilisez stripe listen pour obtenir un secret temporaire
# Pour la production : créez un endpoint dans le Dashboard Stripe
STRIPE_WEBHOOK_SECRET=

# ===========================================
# CONFIGURATION CLOUDINARY
# ===========================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
