# Configuration de la base de données
DATABASE_URL=postgresql://username:password@host:port/database
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=onlyflick
DB_SSLMODE=disable

# Configuration JWT
JWT_SECRET=your-secret-key
JWT_EXPIRATION=24

# Configuration CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:49219,http://127.0.0.1:3000,http://127.0.0.1:49219
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400
